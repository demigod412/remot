Options -Indexes

# Block direct access to sensitive files
<FilesMatch "^(\.env|composer\.(json|lock)|phpunit\.xml|artisan)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve real files/dirs from public/ (assets, css, js, images, etc.)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.+)$ public/$1 [L]

    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.+)/$ public/$1/ [L]

    # Everything else (routes) goes through our front controller
    RewriteRule ^ index.php [QSA,L]
</IfModule>
