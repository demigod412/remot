APP_NAME="Job Station"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jobstation
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=ssl
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Job Station coin / credit unit
JOBSTATION_COIN_NAME="Job Coins"
JOBSTATION_COIN_SYMBOL="JC"

# CodeCanyon / Envato licensing
# PURCHASE_CODE and ENVATO_API_TOKEN are captured from the buyer during
# installation (their purchase code + a personal token from their own Envato
# account) and used to verify the purchase live with Envato. Do not edit by hand.
#
# ENVATO_ITEM_ID — the SELLER sets this to this product's CodeCanyon item id
# (available once the item is published) so a code is checked against THIS item.
PURCHASE_CODE=
ENVATO_API_TOKEN=
ENVATO_ITEM_ID=
# ENVATO_STRICT=true also fails install when the Envato API is unreachable.
# Default (false): continue and re-check later so an outage can't block a valid buyer.
ENVATO_STRICT=false
ENVATO_CACHE_HOURS=12
