# ---------------------------------------------------------------------------
# Job Station — uploads hardening
# Never execute or serve active content from the uploads tree. User-supplied
# files live here; treat every one of them as untrusted static data.
# (Nginx users must replicate this with a `location ^~ /uploads/` block that
#  disables PHP and forces `default_type application/octet-stream`.)
# ---------------------------------------------------------------------------

Options -ExecCGI -Indexes

# Disable the PHP engine for any module-based PHP SAPI.
<IfModule mod_php.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_admin_flag engine off
</IfModule>

# Strip handlers/types so scripts are never interpreted, only downloaded.
RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pht .phar .cgi .pl .py .jsp .asp .aspx .sh
RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pht .phar .cgi .pl .py .jsp .asp .aspx .sh

# Belt-and-braces: hard-deny direct requests to executable file types.
<FilesMatch "(?i)\.(php[0-9]?|phtml|phps|pht|phar|cgi|pl|py|jsp|asp|aspx|sh|bash|htaccess|html?|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
